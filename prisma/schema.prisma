generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// ─────────────────────────────────────────────────────────────
// better-auth canonical schema
// https://www.better-auth.com/docs/concepts/database
// ─────────────────────────────────────────────────────────────

model User {
  id            String   @id @default(cuid())
  email         String   @unique
  emailVerified Boolean  @default(false) @map("email_verified")
  name          String?
  image         String?
  createdAt     DateTime @default(now()) @map("created_at")
  updatedAt     DateTime @updatedAt @map("updated_at")

  // Optional user override of LLM provider config.
  // If null, the server-side env defaults are used.
  // Token armazenado encriptado (AES-256-GCM via src/lib/profile-watch/token-crypto.ts).
  anthropicApiKeyEncrypted String? @map("anthropic_api_key_encrypted")
  anthropicModel           String? @map("anthropic_model")

  // W5 — preferências do usuário (settings expandido).
  // Source of truth: docs/DATA-MODEL.md seção User.
  // notificationPrefs shape: { push: boolean, frequency: "instant"|"daily"|"weekly" }
  timezone          String?    @map("timezone")
  locale            String?    @map("locale")
  coachTone         CoachTone? @map("coach_tone")
  notificationPrefs Json?      @map("notification_prefs")

  sessions          Session[]
  accounts          Account[]
  contacts          Contact[]
  usageLogs         UsageLog[]
  monitoredProfiles MonitoredProfile[]
  userProfile       UserProfile?
  folders           Folder[]
  tagPreferences    TagPreference[]

  @@map("user")
}

// W6 — Memória do Homem. 1-1 com User. Append-only nos arrays (cap defensivo).
// Source of truth: docs/DATA-MODEL.md seção UserProfile.
// effectiveTone (server-only) = userProfile?.tone ?? user.coachTone ?? null.
model UserProfile {
  userId         String     @id @map("user_id")
  tone           CoachTone?
  age            Int?
  locationCity   String?    @map("location_city")
  contextLife    String?    @map("context_life")
  demographics   Json?
  winSamples     Json       @default("[]") @map("win_samples")
  redPatternsRaw Json       @default("[]") @map("red_patterns_raw")
  redPatterns    Json       @default("[]") @map("red_patterns")
  onboardingDone Boolean    @default(false) @map("onboarding_done")
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("user_profile")
}

model Session {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  token     String   @unique
  expiresAt DateTime @map("expires_at")
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("session")
}

model Account {
  id                    String    @id @default(cuid())
  userId                String    @map("user_id")
  accountId             String    @map("account_id")
  providerId            String    @map("provider_id")
  accessToken           String?   @map("access_token")
  refreshToken          String?   @map("refresh_token")
  idToken               String?   @map("id_token")
  accessTokenExpiresAt  DateTime? @map("access_token_expires_at")
  refreshTokenExpiresAt DateTime? @map("refresh_token_expires_at")
  scope                 String?
  password              String?
  createdAt             DateTime  @default(now()) @map("created_at")
  updatedAt             DateTime  @updatedAt @map("updated_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([providerId, accountId])
  @@index([userId])
  @@map("account")
}

model Verification {
  id         String   @id @default(cuid())
  identifier String
  value      String
  expiresAt  DateTime @map("expires_at")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  @@index([identifier])
  @@map("verification")
}

// ─────────────────────────────────────────────────────────────
// FlirtAI domain
// ─────────────────────────────────────────────────────────────

enum ContactStatus {
  active
  cold
  hot_lead
}

enum ContactKind {
  desenrolo
  agent_chat @map("agent chat")
}

enum AttractionLevel {
  Low
  Medium
  High
}

enum MessageSender {
  user
  assistant
  contact
}

enum CoachTone {
  low_key
  direto
  provocador
}

model Contact {
  id                     String          @id @default(cuid())
  userId                 String          @map("user_id")
  kind                   ContactKind     @default(desenrolo)
  name                   String
  age                    Int?
  source                 String          @default("Instagram")
  instagramHandle        String?         @map("instagram_handle")
  avatarUrl              String?         @map("avatar_url")
  tags                   String[]        @default([])
  status                 ContactStatus   @default(active)
  attractionLevel        AttractionLevel @default(Medium) @map("attraction_level")
  personalityType        String?         @map("personality_type")
  interests              String[]        @default([])
  lastInteractionSummary String?         @map("last_interaction_summary")
  conversationSummary    String?         @map("conversation_summary")
  greenFlags             String[]        @default([]) @map("green_flags")
  redFlags               String[]        @default([]) @map("red_flags")
  notes                  String?
  ratingBeleza           Decimal?        @map("rating_beleza") @db.Decimal(3, 1)
  ratingInteligencia     Decimal?        @map("rating_inteligencia") @db.Decimal(3, 1)
  ratingLealdade         Decimal?        @map("rating_lealdade") @db.Decimal(3, 1)
  ratingRespeito         Decimal?        @map("rating_respeito") @db.Decimal(3, 1)
  ratingVestimenta       Decimal?        @map("rating_vestimenta") @db.Decimal(3, 1)
  location               String?
  metContext             String?         @map("met_context")
  // W8 — Org & Hygiene
  pinnedAt               DateTime?       @map("pinned_at")
  archivedAt             DateTime?       @map("archived_at")
  folderId               String?         @map("folder_id")
  createdAt              DateTime        @default(now()) @map("created_at")
  updatedAt              DateTime        @updatedAt @map("updated_at")

  user       User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  folder     Folder?        @relation(fields: [folderId], references: [id], onDelete: SetNull)
  messages   Message[]
  analysis   Analysis?
  encounters EncounterLog[]

  @@index([userId])
  @@index([userId, kind, updatedAt(sort: Desc)])
  @@index([userId, updatedAt(sort: Desc)])
  @@index([userId, archivedAt, pinnedAt(sort: Desc), updatedAt(sort: Desc)])
  @@index([userId, folderId])
  @@map("contact")
}

// W8 — Org & Hygiene
// Pasta criada pelo User pra organizar contatos na sidebar.
// onDelete:SetNull em Contact.folderId garante que apagar pasta não derruba contacts.
model Folder {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  name      String
  color     String?
  icon      String?
  order     Int      @default(0)
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  contacts Contact[]

  @@unique([userId, name])
  @@index([userId, order])
  @@map("folder")
}

// W8 — Mapa user-curado label→cor pra tags. Tags continuam em Contact.tags[]
// (LLM escreve via tool_use); esta tabela só define a cor de display.
model TagPreference {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  label     String
  color     String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, label])
  @@index([userId])
  @@map("tag_preference")
}

// W7 — Diario de Campo. Captura pos-encontro de um Contact.
// raw_text livre PT-BR + extracted JSON via tool_use (Anthropic).
// Alimenta Contact.greenFlags/redFlags/lastInteractionSummary/attractionLevel
// e UserProfile.redPatterns quando extracted.userRedPatterns.length > 0.
// Source of truth: docs/DATA-MODEL.md secao EncounterLog.
//
// SECURITY (IN-05): EncounterLog NAO tem user_id direto. Multi-tenancy
// e enforced via contact_id FK. Toda query DEVE filtrar por contactId E
// re-validar contact.userId === requireUser(). Padrao seguro:
//   { where: { contact: { userId } } } pra defesa em profundidade.
// NUNCA expor endpoint /api/encounters/[id] sem nested ownership.
model EncounterLog {
  id         String   @id @default(cuid())
  contactId  String   @map("contact_id")
  happenedAt DateTime @map("happened_at")
  rawText    String   @map("raw_text")
  extracted  Json
  createdAt  DateTime @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, happenedAt(sort: Desc)])
  @@map("encounter_log")
}

model Message {
  id          String        @id @default(cuid())
  contactId   String        @map("contact_id")
  sender      MessageSender
  content     String
  suggestions Json?
  insight     Json?
  attachments Json?
  // W8 — Marcado pelo user quando ele de fato enviou a mensagem no IG/WA real.
  // Só relevante pra sender = user. Coach pode usar pra distinguir "rascunho" de "enviado".
  sentIrlAt   DateTime?     @map("sent_irl_at")
  createdAt   DateTime      @default(now()) @map("created_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@index([contactId, createdAt])
  @@map("message")
}

model Analysis {
  contactId  String   @id @map("contact_id")
  insights   String?
  strategy   String?
  flags      Json     @default("[]")
  instagram  Json     @default("{}")
  lastAdvice Json     @default("{}") @map("last_advice")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  contact Contact @relation(fields: [contactId], references: [id], onDelete: Cascade)

  @@map("analysis")
}

model UsageLog {
  id        String   @id @default(cuid())
  userId    String   @map("user_id")
  route     String
  createdAt DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt(sort: Desc)])
  @@map("usage_log")
}

// ─────────────────────────────────────────────────────────────
// Profile Watch — monitoramento legítimo de perfis públicos.
// Pensado pra Competitor / Influencer (Apify) e Self-Coach (Graph API).
// Sem campos psicográficos ou de vida privada — só métricas públicas.
// ─────────────────────────────────────────────────────────────

enum ProfileSource {
  self
  competitor
  influencer
}

enum ProfilePlatform {
  instagram
}

enum ProfileWatchStatus {
  active
  paused
  error
}

enum ProfilePostType {
  image
  carousel
  reel
  video
}

enum CoachingDimension {
  bio
  grid
  cadence
  pillars
  engagement
}

enum CoachingSeverity {
  info
  suggestion
  critical
}

model MonitoredProfile {
  id                  String             @id @default(cuid())
  userId              String             @map("user_id")
  source              ProfileSource
  platform            ProfilePlatform    @default(instagram)
  handle              String
  displayName         String?            @map("display_name")
  status              ProfileWatchStatus @default(active)
  lastErrorMessage    String?            @map("last_error_message")
  errorCount          Int                @default(0) @map("error_count")
  cadenceHours        Int                @default(24) @map("cadence_hours")
  lastScanAt          DateTime?          @map("last_scan_at")
  nextScanAt          DateTime?          @map("next_scan_at")
  consentAcceptedAt   DateTime           @map("consent_accepted_at")
  consentVersion      String             @map("consent_version")
  graphAccessToken    String?            @map("graph_access_token")
  graphUserId         String?            @map("graph_user_id")
  graphTokenExpiresAt DateTime?          @map("graph_token_expires_at")
  createdAt           DateTime           @default(now()) @map("created_at")
  updatedAt           DateTime           @updatedAt @map("updated_at")

  user        User                 @relation(fields: [userId], references: [id], onDelete: Cascade)
  snapshots   ProfileSnapshot[]
  posts       ProfilePost[]
  reports     ProfileReport[]
  suggestions CoachingSuggestion[]

  @@unique([userId, platform, handle])
  @@index([userId])
  @@index([nextScanAt, status])
  @@map("monitored_profile")
}

model ProfileSnapshot {
  id             String   @id @default(cuid())
  profileId      String   @map("profile_id")
  capturedAt     DateTime @default(now()) @map("captured_at")
  followersCount Int      @map("followers_count")
  followingCount Int      @map("following_count")
  postsCount     Int      @map("posts_count")
  bio            String?
  avatarUrl      String?  @map("avatar_url")
  isVerified     Boolean  @default(false) @map("is_verified")
  isPrivate      Boolean  @default(false) @map("is_private")
  externalUrl    String?  @map("external_url")
  category       String?
  rawPayload     Json     @map("raw_payload")

  profile MonitoredProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, capturedAt(sort: Desc)])
  @@map("profile_snapshot")
}

model ProfilePost {
  id                String          @id @default(cuid())
  profileId         String          @map("profile_id")
  shortcode         String
  mediaType         ProfilePostType @map("media_type")
  caption           String?
  thumbnailUrl      String?         @map("thumbnail_url")
  permalink         String
  postedAt          DateTime?       @map("posted_at")
  firstSeenAt       DateTime        @default(now()) @map("first_seen_at")
  lastSeenAt        DateTime        @default(now()) @map("last_seen_at")
  isDeleted         Boolean         @default(false) @map("is_deleted")
  deletedDetectedAt DateTime?       @map("deleted_detected_at")
  lastMetrics       Json?           @map("last_metrics")

  profile MonitoredProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, shortcode])
  @@index([profileId, postedAt(sort: Desc)])
  @@index([profileId, isDeleted])
  @@map("profile_post")
}

model ProfileReport {
  id                String   @id @default(cuid())
  profileId         String   @map("profile_id")
  windowStart       DateTime @map("window_start")
  windowEnd         DateTime @map("window_end")
  newPostsCount     Int      @default(0) @map("new_posts_count")
  deletedPostsCount Int      @default(0) @map("deleted_posts_count")
  followersDelta    Int      @default(0) @map("followers_delta")
  engagementAvg     Float?   @map("engagement_avg")
  aiSummary         String   @map("ai_summary")
  aiHighlights      Json     @map("ai_highlights")
  createdAt         DateTime @default(now()) @map("created_at")

  profile MonitoredProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@unique([profileId, windowStart, windowEnd])
  @@index([profileId, windowEnd(sort: Desc)])
  @@map("profile_report")
}

model CoachingSuggestion {
  id           String            @id @default(cuid())
  profileId    String            @map("profile_id")
  dimension    CoachingDimension
  severity     CoachingSeverity  @default(suggestion)
  title        String
  description  String
  actionItems  Json              @map("action_items")
  acknowledged Boolean           @default(false)
  createdAt    DateTime          @default(now()) @map("created_at")

  profile MonitoredProfile @relation(fields: [profileId], references: [id], onDelete: Cascade)

  @@index([profileId, acknowledged, createdAt(sort: Desc)])
  @@map("coaching_suggestion")
}
