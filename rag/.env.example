# RAG FlirtAI — copie p/ .env e preencha o que faltar.

# Banco (porta 5433 p/ nao colidir com o Postgres do app na 5432)
DATABASE_URL=postgresql://flirtai:flirtai_dev_pass@localhost:5433/flirtai_kb

# --- Embedding ---
# local  = fastembed intfloat/multilingual-e5-large (1024d, gratis, offline) [DEFAULT]
# voyage = voyage-3-large (pago, precisa VOYAGE_API_KEY)
# openai = text-embedding-3-large (pago, precisa OPENAI_API_KEY)
EMBEDDING_PROVIDER=local
EMBEDDING_DIMS=1024
EMBEDDING_BATCH=32
LOCAL_EMBEDDING_MODEL=intfloat/multilingual-e5-large

# so se EMBEDDING_PROVIDER=voyage
VOYAGE_API_KEY=
EMBEDDING_MODEL=voyage-3-large

# so se EMBEDDING_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_EMBEDDING_MODEL=text-embedding-3-large

# --- Concept extraction (Stage 2) + antidote (Stage 4) ---
# CONCEPT_PROVIDER = gemini (default, barato) | anthropic
CONCEPT_PROVIDER=gemini
CONCEPT_MAX_PER_ITEM=10

# gemini: chave vem do .env raiz do MeresClaude se nao setar aqui
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# anthropic (so se CONCEPT_PROVIDER=anthropic): reaproveita ../.env do app
ANTHROPIC_API_KEY=
CONCEPT_EXTRACTOR_MODEL=claude-sonnet-4-6

LOG_LEVEL=INFO
