# Database
DATABASE_URL="postgresql://flirtai:flirtai@localhost:5432/flirtai?schema=public"

# Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-3.5-flash-lite"

# better-auth
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
BETTER_AUTH_SECRET=""
BETTER_AUTH_URL="http://localhost:3000"

# SMTP — usado pelo fluxo "esqueci minha senha" (funciona com Resend, Mailgun,
# Gmail app password, etc.). Sem SMTP_HOST, o link de reset sai no log do
# servidor em vez de chegar por email (útil em dev).
SMTP_HOST=""
SMTP_PORT="587"
SMTP_USER=""
SMTP_PASS=""
SMTP_FROM="Flirt.ai <no-reply@meresiam.com>"

# Rate limit
RATE_LIMIT_PER_HOUR="60"

# Admin — emails (separados por vírgula) com acesso ao /admin e poder de
# aprovar cadastros. Sem essa var, ninguém é admin (fail-closed).
ADMIN_EMAILS=""

# ─────────────────────────────────────────────────────────────
# Profile Watch
# ─────────────────────────────────────────────────────────────

# Apify token (https://console.apify.com/account/integrations)
APIFY_API_TOKEN=""
# Actor ID. Default cobre 95% dos casos.
APIFY_INSTAGRAM_ACTOR_ID="apify~instagram-profile-scraper"

# Cron handler — POST /api/cron/profile-scan exige header X-Cron-Secret.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
CRON_SECRET=""

# Limites (todos opcionais — defaults já estão sensatos).
PROFILES_PER_USER_LIMIT="3"
PROFILE_WATCH_BATCH_SIZE="50"
PROFILE_WATCH_CADENCE_MIN="6"
PROFILE_WATCH_CADENCE_MAX="168"
PROFILE_WATCH_REPORT_WINDOW="24"
PROFILE_WATCH_RETENTION_DAYS="180"

# Meta Graph API (Wave 4 — Self-Coach). Não preencher ainda; App Review pendente.
META_APP_ID=""
META_APP_SECRET=""
META_OAUTH_REDIRECT_URI=""

# ─────────────────────────────────────────────────────────────
# Observability — Langfuse self-hosted (Wave 0 / C7)
# ─────────────────────────────────────────────────────────────
# Se as 3 vars não forem setadas, o wrap vira no-op (apenas log estruturado em stdout).
# Provisionar instância no Coolify VPS (ver docs/HANDOFF-W0.md).
LANGFUSE_PUBLIC_KEY=""
LANGFUSE_SECRET_KEY=""
LANGFUSE_BASE_URL="https://langfuse.meresiam.com"
